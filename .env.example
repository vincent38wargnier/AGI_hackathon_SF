# --- OpenAI: STT (realtime transcription), embeddings, web search, fallback TTS ---
OPENAI_API_KEY=

# --- General Compute: fast-inference brain (plan/respond), bridge acks, semantic endpointer ---
BRAIN_PROVIDER=gc
GC_API_KEY=
GC_BASE_URL=https://api.generalcompute.com
GC_BRAIN_MODEL=gpt-oss-120b
GC_BRIDGE_MODEL=gpt-oss-120b

# --- Semantic endpointer (mid-thought pauses no longer steal the turn) ---
SEMANTIC_ENDPOINT=on
SEMANTIC_ENDPOINT_MODEL=gpt-oss-120b
SEMANTIC_ENDPOINT_TIMEOUT_MS=850
SEMANTIC_ENDPOINT_MAX_HOLD_MS=8000

# --- Gradium (voice AI): streaming TTS voice + optional STT ears ---
TTS_PROVIDER=gradium
STT_PROVIDER=openai
GRADIUM_API_KEY=
GRADIUM_BASE=wss://us.api.gradium.ai
GRADIUM_VOICE_ID=
GRADIUM_STT_LANGUAGE=any
GRADIUM_STT_DELAY_FRAMES=16

# --- ask_claude: delegated builds via the Claude Code CLI ---
CLAUDE_BIN=
CLAUDE_TASK_MODEL=claude-sonnet-4-6
CLAUDE_TASK_DIR=
CLAUDE_TASK_TIMEOUT_MS=240000

# --- Server ---
PORT=4793
HOST=127.0.0.1

# --- Optional overrides ---
# OPENAI_COMMUNICATOR_MODEL=gpt-4.1-2025-04-14
# OPENAI_BRIDGE_MODEL=gpt-5.4-nano
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
# OPENAI_TRANSCRIBE_PROMPT=
# OPENAI_TRANSCRIBE_LANGUAGE=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
